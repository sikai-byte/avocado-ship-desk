# Leave WIX_* empty to run against bundled sample orders.
# Wix: Dashboard → Settings → API Keys → create key with eCommerce (Orders, Fulfillments) permissions.
WIX_API_KEY=
WIX_SITE_ID=
# Only needed for account-level API keys
WIX_ACCOUNT_ID=
# Force a source: mock | wix (defaults to wix when WIX_API_KEY is set)
ORDER_SOURCE=

# Optional: buy labels directly from the app. Use a shippo_test_ key first.
SHIPPO_API_KEY=

# Optional shared password for the dashboard/API (?key=... or x-api-key header)
APP_KEY=

PORT=3100
DATA_DIR=./data
